# ─── Queue ────────────────────────────────────────────────────────────────
# memory (default, zero infra) | redis (BullMQ — needs `docker compose up`)
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ─── Concurrency ──────────────────────────────────────────────────────────
# Number of parallel workers (each holds one browser context, ~50–100MB).
# Also caps Inngest per-site concurrency + throttle (pacing).
WORKER_CONCURRENCY=2

# Inngest worker HTTP port (functions served here for the dev server).
PORT=3939

# ─── Telemetry ────────────────────────────────────────────────────────────
# On hard failure, capture error.log + screenshot + page.html + Playwright trace
# into <TELEMETRY_DIR>/failures/<job>/. Replay a trace: npx playwright show-trace <trace.zip>
TELEMETRY_ENABLED=true
TELEMETRY_DIR=telemetry

# ─── Headless ─────────────────────────────────────────────────────────────
HEADLESS=true

# ─── Stealth / proxy ──────────────────────────────────────────────────────
# Leave PROXY_URL blank to run direct. Format: http://user:pass@host:port
PROXY_URL=
# Proxy POOL (scale): comma-separated. Each entry may carry geo tags for
# identity↔proxy coherence:  http://user:pass@host:port|US|America/New_York
# Leave blank to run direct. Live use needs a residential proxy account.
PROXY_URLS=

# ─── Booking.com credentials (optional) ───────────────────────────────────
# If unset, the Booking workflow is skipped and only SauceDemo runs.
BOOKING_EMAIL=
BOOKING_PASSWORD=

# ─── SauceDemo credentials (public demo creds) ────────────────────────────
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# ─── CAPTCHA solving (avoid > solve; OFF by default) ──────────────────────
# none | mock | 2captcha. Live solving needs a 2Captcha account + credits.
CAPTCHA_PROVIDER=none
CAPTCHA_API_KEY=

# ─── Tier-4 AI locator resolver (gated OFF by default) ────────────────────
# Routed via the official OpenRouter SDK (@openrouter/sdk). Cheap default model.
AI_LOCATOR_ENABLED=false
OPENROUTER_API_KEY=
AI_LOCATOR_MODEL=google/gemini-2.5-flash-lite
