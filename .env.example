# ─── Queue ────────────────────────────────────────────────────────────────
# memory (default, zero infra) | redis (BullMQ — needs `docker compose up`)
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ─── Concurrency ──────────────────────────────────────────────────────────
# Number of parallel workers (each holds one browser context, ~50–100MB).
WORKER_CONCURRENCY=2

# ─── Headless ─────────────────────────────────────────────────────────────
HEADLESS=true

# ─── Stealth / proxy ──────────────────────────────────────────────────────
# Leave PROXY_URL blank to run direct. Format: http://user:pass@host:port
PROXY_URL=

# ─── Booking.com credentials (optional) ───────────────────────────────────
# If unset, the Booking workflow is skipped and only SauceDemo runs.
BOOKING_EMAIL=
BOOKING_PASSWORD=

# ─── SauceDemo credentials (public demo creds) ────────────────────────────
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# ─── Tier-4 AI locator resolver (gated OFF by default) ────────────────────
# Routed via the official OpenRouter SDK (@openrouter/sdk). Cheap default model.
AI_LOCATOR_ENABLED=false
OPENROUTER_API_KEY=
AI_LOCATOR_MODEL=google/gemini-2.5-flash-lite
